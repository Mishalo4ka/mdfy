{
  "name": "mdfy",
  "version": "0.2.0",
  "description": "Turn text, images, and articles into clean Markdown inside Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "llm",
    "ocr"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "heic2any": "^0.0.4",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "jsdom": "^26.0.0",
    "obsidian": "latest",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^5.0.1"
  }
}
